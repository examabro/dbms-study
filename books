CREATE PROCEDURE GetBookDetails(IN p_Bookid INT)
BEGIN
  DECLARE v_Bookname VARCHAR(100);
  DECLARE v_Author VARCHAR(100);
  DECLARE v_Publication VARCHAR(50);
  DECLARE v_Price DECIMAL(10, 2);

  -- Try to fetch book details
  BEGIN
    SELECT Book_name, Author, Publication, Price
    INTO v_Bookname, v_Author, v_Publication, v_Price
    FROM Book
    WHERE Bookid = p_Bookid;

    -- Display book details
    DBMS_OUTPUT.PUT_LINE('Book Name: ' || v_Bookname);
    DBMS_OUTPUT.PUT_LINE('Author: ' || v_Author);
    DBMS_OUTPUT.PUT_LINE('Publication: ' || v_Publication);
    DBMS_OUTPUT.PUT_LINE('Price: ' || v_Price);

  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      DBMS_OUTPUT.PUT_LINE('No Book found with the given Bookid');
    WHEN OTHERS THEN
      DBMS_OUTPUT.PUT_LINE('An error occurred while fetching the book details');
  END;
END;
//

DELIMITER ;

