-- Create Book Table
CREATE TABLE Book (
  Bookid INT PRIMARY KEY,
  Book_name VARCHAR(100),
  Author VARCHAR(100),
  Publication VARCHAR(50),
  Price DECIMAL(10, 2)
);

-- Create User Table
CREATE TABLE User (
  Userid INT PRIMARY KEY,
  Name VARCHAR(100),
  Dept VARCHAR(50),
  Bookid INT,
  Accdate DATE,
  FOREIGN KEY (Bookid) REFERENCES Book(Bookid)
);


