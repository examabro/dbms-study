CREATE TABLE Product (
    Prodid INT PRIMARY KEY,
    Prodesc VARCHAR(100),
    Price DECIMAL(10, 2),
    Stock INT
);


CREATE TABLE Sales (
    Salesid INT PRIMARY KEY,
    Prodid INT,
    qty INT,
    FOREIGN KEY (Prodid) REFERENCES Product(Prodid)
);


1-->ALTER TABLE Product
