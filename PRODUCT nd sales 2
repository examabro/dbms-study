2-->SELECT 
    s.Salesid,
    p.Prodesc,
    s.qty,
    p.Price,
    (s.qty * p.Price) AS Total
FROM 
    Sales s
JOIN 
    Product p ON s.Prodid = p.Prodid;


3-->SELECT 
    Prodid
FROM 
    Sales
GROUP BY 
    Prodid
ORDER BY 
    SUM(qty) DESC;


