4-->CREATE OR REPLACE PROCEDURE Calculate_Marks_Summary AS
    v_sum    NUMBER;
    v_avg    NUMBER;
BEGIN
    FOR student IN (SELECT * FROM mark_details) LOOP
        -- Calculate sum of marks
        v_sum := student.mark1 + student.mark2 + student.mark3;
        -- Calculate average
        v_avg := v_sum / 3;

        -- Output the result
        DBMS_OUTPUT.PUT_LINE('Reg No: ' || student.reg_no || ' Sum: ' || v_sum || ' Average: ' || v_avg);
    END LOOP;
END;

