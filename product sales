-- Create Product Table
CREATE TABLE Product (
  Prodid INT PRIMARY KEY,
  Prodesc VARCHAR(100),
  Price DECIMAL(10, 2),
  Stock INT
);

-- Create Sales Table
CREATE TABLE Sales (
  Salesid INT PRIMARY KEY,
  Prodid INT,
  qty INT,
  FOREIGN KEY (Prodid) REFERENCES Product(Prodid)
);


