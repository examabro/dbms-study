-- Create Employee table
CREATE TABLE Employee (
    Empno INT PRIMARY KEY,
    Ename VARCHAR(100),
    Job VARCHAR(50),
    MgrId INT,
    DoB DATE,
    DoJ DATE,
    Sal DECIMAL(10, 2),
    Comm DECIMAL(10, 2),
    Deptno INT
);

