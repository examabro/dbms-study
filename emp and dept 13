4-->CREATE OR REPLACE FUNCTION Get_Employee_Details(p_empno INT) RETURN VARCHAR2 AS
    v_ename Employee.Ename%TYPE;
BEGIN
    BEGIN
        SELECT Ename INTO v_ename FROM Employee WHERE Empno = p_empno;
        RETURN 'Employee Name: ' || v_ename;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RETURN 'Employee not found';
    END;
END;

