3-->DECLARE
    v_regno Student.Regno%TYPE := &regno;
BEGIN
    -- Fetching and displaying the student details
    SELECT Name, Dept
    INTO :v_name, :v_dept
    FROM Student
    WHERE Regno = v_regno;
    
    DBMS_OUTPUT.PUT_LINE('Name: ' || :v_name || ', Department: ' || :v_dept);

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('Student not found.');
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);
END;


