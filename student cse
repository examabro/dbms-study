conn = sqlite3.connect("college.db")
c = conn.cursor()
c.execute("CREATE TABLE IF NOT EXISTS Student (Regno INTEGER PRIMARY KEY, Name TEXT, Dept TEXT)")

w = tk.Tk()
w.title("Student Registration")
for i, label in enumerate(("Reg No", "Name", "Department")):
    tk.Label(w, text=label).grid(row=i, column=0)
