CREATE TRIGGER DisplayHomeLoanDetails
AFTER INSERT ON HomeLoan
FOR EACH ROW
BEGIN
  DECLARE loanDetails VARCHAR(200);
  SET loanDetails = CONCAT('HomeLoan Inserted: HLoanid = ', NEW.HLoanid, ', Amount = ', NEW.Amount, ', Custid = ', NEW.Custid);
  SELECT loanDetails AS HomeLoanDetails;
END;
