4-->DELIMITER //

CREATE FUNCTION GetSalary(eid INT)
RETURNS INT
DETERMINISTIC
BEGIN
  DECLARE sal_value INT;

  -- Get salary into variable
  SELECT Sal INTO sal_value FROM Employee WHERE EmpId = eid;

  -- Return salary
  RETURN sal_value;

EXCEPTION
  -- If no data found
  WHEN NOT FOUND THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Employee Not Found';

END;
//

DELIMITER ;

