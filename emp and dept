-- Create Department Table
CREATE TABLE Dept (
  Deptno INT PRIMARY KEY,
  Dname VARCHAR(50),
  Loc VARCHAR(50),
  DeptmanagerId INT
);

-- Create Employee Table
CREATE TABLE Employee (
  EmpId INT PRIMARY KEY,
  Empname VARCHAR(50),
  Sal INT,
  Deptno INT,
  FOREIGN KEY (Deptno) REFERENCES Dept(Deptno)
);


