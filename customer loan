CREATE PROCEDURE p2(IN l INT)
BEGIN
  DECLARE l1 INT;

  -- Try to get the Loan ID into l1
  SELECT Loanid INTO l1 FROM Loan WHERE Loanid = l;

  -- Check if loan ID is not found (NULL)
  IF l1 IS NULL THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Data not found';
  ELSE
    -- If loan ID is found, show Custid and Amount
    SELECT Custid, Amount FROM Loan WHERE Loanid = l;
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Data found';
  END IF;

END;
