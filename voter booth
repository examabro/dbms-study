CREATE FUNCTION GetPollPercentage(bid INT)
RETURNS DECIMAL(5,2)
DETERMINISTIC
BEGIN
  DECLARE total INT;
  DECLARE voted INT;
  DECLARE percentage DECIMAL(5,2);

  -- Get total voters in the booth
  SELECT COUNT(*) INTO total FROM Voter WHERE Boothid = bid;

  -- If no voters in the booth, throw error
  IF total = 0 THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'No voters in this booth';
  END IF;

  -- Get voted count
  SELECT COUNT(*) INTO voted FROM Voter WHERE Boothid = bid AND Checkvote = 1;

  -- Calculate percentage
  SET percentage = (voted / total) * 100;

  RETURN percentage;
END;
//

DELIMITER ;

