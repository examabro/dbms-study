2-->UPDATE Loan
SET Interest = Interest + 1
WHERE Custid IN (
  SELECT Custid
  FROM Account A
  JOIN Loan L ON A.Custid = L.Custid
  WHERE A.Accbal > 0.5 * L.Amount
);


3-->CREATE VIEW CustomerLoanDetails AS
SELECT A.Custid, A.Accbal, L.Amount AS LoanAmount
FROM Account A
JOIN Loan L ON A.Custid = L.Custid;


