### **Step 3: Employee Form (Python + Tkinter)**

```python
import sqlite3
import tkinter as tk
from tkinter import messagebox

# Connect to SQLite database
conn = sqlite3.connect('company.db')
cursor = conn.cursor()

# Create Employee table if not exists
cursor.execute("""
CREATE TABLE IF NOT EXISTS Employee (
    Empno INTEGER PRIMARY KEY,
    Empname TEXT,
    Designation TEXT,
    Date_of_join TEXT,
    Salary REAL NOT NULL,
    Depno INTEGER,
    FOREIGN KEY (Depno) REFERENCES Department(Depno)
)
""")
conn.commit()

# Function to display employee details
def display_employee():
    empno = entry_empno.get()
    cursor.execute("SELECT * FROM Employee WHERE Empno = ?", (empno,))
    emp = cursor.fetchone()
    if emp:
        messagebox.showinfo("Employee Details", f"Emp No: {emp[0]}\nName: {emp[1]}\nDesignation: {emp[2]}\nJoin Date: {emp[3]}\nSalary: {emp[4]}\nDept No: {emp[5]}")
    else:
        messagebox.showwarning("Not Found", "Employee not found.")

# Function to delete employee
def delete_employee():
    empno = entry_empno.get()
    cursor.execute("DELETE FROM Employee WHERE Empno = ?", (empno,))
    conn.commit()
    messagebox.showinfo("Success", f"Employee {empno} deleted successfully.")
    entry_empno.delete(0, tk.END)

# Setup Tkinter window
window = tk.Tk()
window.title("Employee Form")

# Labels and Entry Fields
tk.Label(window, text="Employee Number").grid(row=0, column=0, padx=10, pady=5)
entry_empno = tk.Entry(window)
entry_empno.grid(row=0, column=1, pady=5)

# Buttons
tk.Button(window, text="Display", command=display_employee).grid(row=1, column=0, columnspan=2, pady=5)
tk.Button(window, text="Delete", command=delete_employee).grid(row=2, column=0, columnspan=2, pady=5)

window.mainloop()

# Close connection
conn.close()
```

